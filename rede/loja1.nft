flush ruleset
table inet loja {
 chain forward {
  type filter hook forward priority 0; policy drop;
  ct state established,related accept
  # convidados nao chegam a nenhuma rede corporativa, mesmo durante failover
  iifname "eth4" ip daddr 10.20.0.0/16 drop
  # caixa -> ERP: HTTPS e ping
  iifname "eth3" ip daddr 10.20.2.0/25 tcp dport 443 accept
  iifname "eth3" ip daddr 10.20.2.0/25 ip protocol icmp icmp type echo-request accept
  # IoT -> servidor de video
  iifname "eth5" ip daddr 10.20.2.0/25 tcp dport 8554 accept
  # convidados acessam exclusivamente sites externos pela internet local
  iifname "eth4" oifname "eth2" ip daddr != 10.20.0.0/16 accept
 }
 chain postrouting {
  type nat hook postrouting priority 100;
  oifname "eth2" ip saddr 10.20.4.0/24 ip daddr != 10.20.0.0/16 masquerade
 }
}
